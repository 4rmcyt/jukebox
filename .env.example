# Copy to .env and fill in. Secrets do not go here: see ./secrets/ in docs/design-compose.md.

# IANA time zone of the office, e.g. America/Edmonton.
TZ=
# Owner of the PipeWire session the speaker is connected to (`id -u`, `id -g`).
HOST_UID=1000
HOST_GID=1000

# Work hours: squeezelite runs only inside them.
WORK_DAYS="Mon Tue Wed Thu Fri"
WORK_START=07:00
WORK_END=17:00
# Optional: pin the speaker sink (`pactl list short sinks`), e.g. bluez_output.AA_BB_CC_DD_EE_FF.1
OUTPUT_DEVICE=

# Web UI
FQDN=jukebox.example.com
ACME_EMAIL=
# Space-separated CIDRs allowed to reach /stats and /mcp.
ADMIN_NETS=""

# Teams bridge (docs/installation.md §13)
BRIDGE_TENANT_ID=
BRIDGE_CLIENT_ID=
BRIDGE_TEAM_ID=
BRIDGE_CHANNEL_ID=
# Comma-separated Entra object IDs allowed to run admin commands.
BRIDGE_ADMIN_IDS=
# Subset of: music.youtube.com,youtube.com,youtu.be
BRIDGE_ALLOWED_DOMAINS=music.youtube.com,youtube.com,youtu.be
BRIDGE_RETENTION_DAYS=90
